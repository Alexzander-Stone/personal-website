---
import Layout from './Layout.astro';
import { type ProjectFrontmatter } from '../types';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { frontmatter }: { [key: string]: ProjectFrontmatter } = Astro.props;
const parsedDate = new Date(frontmatter.pubDate);
const pubDate = Number.isNaN(parsedDate.getTime())
  ? frontmatter.pubDate
  : parsedDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });
---

<Layout
  title={`${frontmatter.title} | Alexzander Stone`}
  description={frontmatter.description}
  ogImage={frontmatter.image.url}
  ogType="article"
  publishedDate={frontmatter.pubDate}
  tags={frontmatter.tags}
>
  <Header />

  <main class="project-page">
    <article>
      <figure class="hero-media">
        <img
          decoding="async"
          loading="eager"
          src={frontmatter.image.url}
          alt={frontmatter.image.alt}
          width={frontmatter.image.width.normal}
          height={frontmatter.image.height.normal}
        />
      </figure>

      <div class="article-head">
        <p class="source">Source: {frontmatter.image.source}</p>
        <h1>{frontmatter.title}</h1>
        <p class="meta">{pubDate}</p>

        <ul class="tags" role="list" aria-label="Project tags">
          {frontmatter.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>

      <div class="prose">
        <slot />
      </div>
    </article>

    <aside class="project-progress" aria-label="Section progression" hidden>
      <p class="project-progress-title">Progress</p>
      <ol id="project-progress-list" class="project-progress-list" role="list"></ol>
    </aside>

    <Footer />
  </main>
</Layout>

<script is:inline>
  (() => {
    const page = document.querySelector('.project-page');
    const prose = page?.querySelector('.prose');
    const progress = page?.querySelector('.project-progress');
    const list = page?.querySelector('#project-progress-list');

    if (!page || !prose || !progress || !list) {
      return;
    }

    const headings = Array.from(prose.querySelectorAll('h2, h3'));
    if (headings.length === 0) {
      progress.setAttribute('hidden', '');
      return;
    }

    const slugify = (value) =>
      value
        .toLowerCase()
        .trim()
        .replace(/[^\w\s-]/g, '')
        .replace(/\s+/g, '-');

    list.innerHTML = '';

    headings.forEach((heading, index) => {
      const text = heading.textContent?.trim() || `Section ${index + 1}`;
      if (!heading.id) {
        heading.id = `${slugify(text) || 'section'}-${index + 1}`;
      }

      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.textContent = text;
      link.title = text;
      link.className = heading.tagName === 'H3' ? 'is-subsection' : 'is-section';
      link.dataset.target = heading.id;
      item.appendChild(link);
      list.appendChild(item);
    });

    progress.removeAttribute('hidden');

    const links = Array.from(list.querySelectorAll('a'));
    const setActive = (id) => {
      links.forEach((link) => {
        const isActive = link.dataset.target === id;
        link.classList.toggle('is-active', isActive);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible.length > 0) {
          setActive(visible[0].target.id);
          return;
        }

        const above = entries
          .filter((entry) => entry.boundingClientRect.top < 0)
          .sort((a, b) => b.boundingClientRect.top - a.boundingClientRect.top);

        if (above.length > 0) {
          setActive(above[0].target.id);
        }
      },
      {
        rootMargin: '-20% 0px -70% 0px',
        threshold: [0, 1],
      }
    );

    headings.forEach((heading) => observer.observe(heading));

    const fromHash = window.location.hash.slice(1);
    if (fromHash) {
      setActive(fromHash);
    } else if (headings[0]) {
      setActive(headings[0].id);
    }
  })();
</script>

<style>
  .project-page {
    width: min(900px, calc(100% - 2rem));
    position: relative;
  }

  .hero-media {
    margin: 0 calc(50% - 50vw) 1.4rem;
    max-height: min(60vh, 680px);
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    max-height: min(60vh, 680px);
    object-fit: cover;
  }

  .article-head {
    display: grid;
    gap: 0.55rem;
    margin-bottom: 1rem;
  }

  .source,
  .meta {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.84rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.1rem);
  }

  .tags {
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem;
  }

  .tags li {
    margin: 0;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-primary);
    border: 1px solid rgba(47, 132, 136, 0.44);
    border-radius: 6px;
    padding: 0.22rem 0.62rem;
    background: rgba(47, 132, 136, 0.14);
  }

  .project-progress {
    position: fixed;
    top: 7.2rem;
    left: calc(50% + 470px);
    width: 220px;
    background: rgba(255, 248, 237, 0.86);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    box-shadow: var(--shadow-soft);
    padding: 0.72rem 0.72rem 0.76rem;
    z-index: 2;
    backdrop-filter: blur(2px);
  }

  .project-progress-title {
    margin: 0 0 0.45rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-progress-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.24rem;
    position: relative;
  }

  .project-progress-list::before {
    content: '';
    position: absolute;
    left: 0.32rem;
    top: 0.2rem;
    bottom: 0.2rem;
    width: 1px;
    background: rgba(126, 104, 79, 0.36);
  }

  .project-progress-list li {
    margin: 0;
    position: relative;
  }

  .project-progress-list a {
    position: relative;
    display: block;
    color: var(--text-secondary);
    font-size: 0.74rem;
    line-height: 1.28;
    text-decoration: none;
    padding: 0.2rem 0.2rem 0.2rem 1.05rem;
    border-radius: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .project-progress-list a::before {
    content: '';
    position: absolute;
    left: 0.16rem;
    top: 0.52rem;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 999px;
    background: var(--bg-deep);
    border: 1px solid rgba(126, 104, 79, 0.5);
  }

  .project-progress-list a.is-subsection {
    padding-left: 1.42rem;
    font-size: 0.71rem;
    color: var(--text-muted);
  }

  .project-progress-list a.is-subsection::before {
    left: 0.55rem;
    width: 0.26rem;
    height: 0.26rem;
  }

  .project-progress-list a:hover {
    background: var(--bg-surface-hover);
  }

  .project-progress-list a.is-active {
    color: var(--text-primary);
    background: rgba(47, 132, 136, 0.13);
  }

  .project-progress-list a.is-active::before {
    background: var(--accent-secondary);
    border-color: var(--accent-secondary);
  }

  @media (max-width: 760px) {
    .project-page {
      width: min(900px, calc(100% - 1.4rem));
    }

    .hero-media {
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 1320px) {
    .project-progress {
      display: none;
    }
  }
</style>
