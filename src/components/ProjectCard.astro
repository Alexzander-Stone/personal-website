---
interface Props {
  title: string;
  photoUrl: string;
  photoAlt: string;
  body: string;
  href: string;
  headingTag?: 'h2' | 'h3';
  width?: number;
  height?: number;
  tags?: string[];
  pubDate?: string | Date;
  delayMs?: number;
}

const {
  href,
  photoUrl,
  photoAlt,
  title,
  body,
  headingTag = 'h3',
  width,
  height,
  tags = [],
  pubDate,
} = Astro.props;
const visibleTags = tags.slice(0, 5);
const extraTags = tags.length - visibleTags.length;
const parsedDate = pubDate ? new Date(pubDate) : null;
const formattedDate =
  parsedDate && !Number.isNaN(parsedDate.getTime())
    ? parsedDate.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      })
    : undefined;
---

<li class="project-card">
  <a class="project-link" href={href}>
    <figure class="media">
      <img
        src={photoUrl}
        alt={photoAlt}
        loading="lazy"
        decoding="async"
        width={width}
        height={height}
      />
    </figure>

    <div class="card-content">
      <div class="title-row">
        {
          headingTag === 'h2' ? (
            <h2 class="card-title">{title}</h2>
          ) : (
            <h3 class="card-title">{title}</h3>
          )
        }
        {formattedDate && <p class="date">{formattedDate}</p>}
      </div>

      <p>{body}</p>

      {visibleTags.length > 0 && (
        <ul class="tags" role="list" aria-label="Project technologies">
          {visibleTags.map((tag) => (
            <li>{tag}</li>
          ))}
          {extraTags > 0 && <li class="more">+{extraTags}</li>}
        </ul>
      )}
    </div>
  </a>
</li>

<style>
  .project-card {
    list-style: none;
  }

  .project-link {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--border-subtle);
  }

  .project-link:hover .card-title,
  .project-link:focus-visible .card-title {
    color: var(--accent-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .media {
    margin: 0.2rem 0 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-content {
    min-width: 0;
    display: grid;
    gap: 0.35rem;
  }

  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-title {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.25;
  }

  .date {
    margin: 0;
    flex-shrink: 0;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    line-height: 1.3;
    white-space: nowrap;
  }

  p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.48;
    font-size: 0.95rem;
  }

  .tags {
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .tags li {
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: var(--tag-font-size);
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    border-radius: var(--tag-radius);
    padding: var(--tag-padding);
  }

  .more {
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .project-link {
      grid-template-columns: 5.75rem minmax(0, 1fr);
      gap: 0.8rem;
    }

    .title-row {
      display: grid;
      gap: 0.1rem;
    }

    .date {
      white-space: normal;
    }
  }
</style>
