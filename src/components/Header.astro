---
const bearFaces = [
  "ฅʕ'ᴥ'ʔฅ",
  "ʕ•ᴥ•ʔっ",
  "ฅʕ•ᴥ•ʔฅ",
  "ฅʕ•ᴥ•ʔ",
  "ʕ•ᴥ•ʔฅ",
  "ʕ ꈍᴥꈍʔ",
  "ლʕ´☉ᴥ☉`ʔლ",
  "ʕっ￫ᴥ￩ʔっ",
  "ʕ•̀ω•́ʔ✧",
  "╮ʕ˚ᴥ˚ʔ╭",
  "＼ʕ•ᴥ•ʔ／",
  "ʕ♥ᴥ♥ʔ",
];

const winkBearFaces = [
  "ฅʕ-ᴥ'ʔฅ",
  "ʕ-ᴥ•ʔっ",
  "ฅʕ•ᴥ-ʔฅ",
  "ฅʕ-ᴥ-ʔ",
  "ʕ-ᴥ-ʔฅ",
  "ʕ ꈍᴥꈍʔ",
  "ლʕ´-ᴥ-`ʔლ",
  "ʕっ•ᴥ•ʔっ",
  "ʕ•̀ω-ʔ✧",
  "╮ʕ-ᴥ-ʔ╭",
  "＼ʕ•ᴥ-ʔ／",
  "ʕ-ᴥ-ʔ",
];

const bearIndex = Date.now() % bearFaces.length;
const chosenBear = bearFaces[bearIndex];
const winkChosenBear = winkBearFaces[bearIndex];
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHomePage = pathname === '/';
const isProjectsPage = pathname === '/projects' || pathname.startsWith('/projects/');
---

<header class="site-header" data-scrolled="false">
  <div class="header-inner">
    <a class="bear-link" href="/bear" aria-label="Visit the bear page">
      <span class="bear-default" aria-hidden="true">{chosenBear}</span>
      <span class="bear-wink" aria-hidden="true">{winkChosenBear}</span>
    </a>

    <nav aria-label="Primary">
      <a href="/" aria-current={isHomePage ? 'page' : undefined}>Home</a>
      <a href="/projects" aria-current={isProjectsPage ? 'page' : undefined}>Projects</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');

  if (header && !window.__headerScrollBound) {
    const onScroll = () => {
      const isScrolled = window.scrollY > 10;
      header.setAttribute('data-scrolled', isScrolled ? 'true' : 'false');
    };

    window.__headerScrollBound = true;
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('astro:after-swap', onScroll);
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 30;
    background: rgba(247, 241, 228, 0.9);
    backdrop-filter: blur(12px);
    transition: background-color 220ms ease;
  }

  .site-header[data-scrolled='true'] {
    background: rgba(247, 241, 228, 0.97);
  }

  .header-inner {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    min-height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .bear-link {
    display: inline-grid;
    place-items: center;
    min-height: 2.25rem;
    padding: 0 0.2rem;
    text-decoration: none;
    font-size: 1.08rem;
    color: var(--text-primary);
    transition: color 180ms ease;
  }

  .bear-default,
  .bear-wink {
    grid-area: 1 / 1;
    transition: opacity 180ms ease;
  }

  .bear-wink {
    opacity: 0;
  }

  .bear-link:hover .bear-default,
  .bear-link:focus-visible .bear-default {
    opacity: 0;
  }

  .bear-link:hover .bear-wink,
  .bear-link:focus-visible .bear-wink {
    opacity: 1;
  }

  .bear-link:hover,
  .bear-link:focus-visible {
    color: var(--accent-primary);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    padding: 0.15rem 0.2rem 0.25rem;
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    text-decoration: none !important;
    text-decoration-line: none !important;
    transition: color 180ms ease;
  }

  nav a:visited,
  nav a:hover,
  nav a:focus-visible,
  nav a:active {
    text-decoration: none !important;
    text-decoration-line: none !important;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--accent-primary);
  }

  nav a[aria-current='page'] {
    color: var(--text-primary);
  }

  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.06rem;
    height: 1px;
    background: var(--accent-primary);
  }

  @media (max-width: 760px) {
    .header-inner {
      width: min(1120px, calc(100% - 1.4rem));
      min-height: 3.6rem;
    }

    nav {
      gap: 0.65rem;
    }

    nav a {
      font-size: 0.87rem;
      padding: 0.15rem 0.15rem;
    }
  }
</style>
