---
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHomePage = pathname === '/';
const isProjectsPage = pathname === '/projects' || pathname.startsWith('/projects/');
---

<header class="site-header">
  <div class="header-inner">
    <a class="site-name" href="/">Alexzander Stone</a>

    <nav aria-label="Primary">
      <a href="/" aria-current={isHomePage ? 'page' : undefined}>Home</a>
      <a href="/projects" aria-current={isProjectsPage ? 'page' : undefined}>Projects</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-deep);
  }

  .header-inner {
    width: min(920px, calc(100% - 2rem));
    margin: 0 auto;
    min-height: 3.5rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-name {
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }

  nav a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current='page'] {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  @media (max-width: 760px) {
    .header-inner {
      width: min(920px, calc(100% - 1.4rem));
      min-height: 3.25rem;
    }

    nav {
      gap: 0.75rem;
      font-size: 0.86rem;
    }
  }
</style>
