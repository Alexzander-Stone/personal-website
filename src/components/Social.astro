---
---

<div class="social-grid" aria-label="Social profiles and handles">
  <a
    class="social-pill"
    href="mailto:alexwrstone@gmail.com?subject=Project%20inquiry&body=Hey%20Alex%2C%20saw%20your%20site%20and%20wanted%20to%20reach%20out."
    target="_blank"
    rel="noreferrer"
  >
    <img
      class="social-img"
      src="/socials/gmail.png"
      alt="Gmail icon"
      decoding="async"
      loading="lazy"
      width="20"
      height="15"
    />
    AlexWRStone
  </a>

  <span class="social-pill" aria-label="Discord handle">
    <img
      class="social-img"
      src="/socials/discord-dark.svg"
      alt="Discord icon"
      decoding="async"
      loading="lazy"
      width="20"
      height="20"
    />
    Derzan
  </span>

  <a
    class="social-pill"
    href="https://github.com/alexzander-stone"
    target="_blank"
    rel="noreferrer"
  >
    <img
      class="social-img"
      src="/socials/github-dark.svg"
      alt="GitHub icon"
      decoding="async"
      loading="lazy"
      width="20"
      height="20"
    />
    alexzander-stone
  </a>

  <a
    class="social-pill"
    href="https://t.me/SheepyWeb3"
    target="_blank"
    rel="noreferrer"
  >
    <img
      class="social-img"
      src="/socials/telegram.png"
      alt="Telegram icon"
      decoding="async"
      loading="lazy"
      width="20"
      height="20"
    />
    SheepyWeb3
  </a>

  <a
    class="social-pill"
    href="https://x.com/sheepyweb3"
    target="_blank"
    rel="noreferrer"
  >
    <img
      class="social-img"
      src="/socials/x.svg"
      alt="X icon"
      decoding="async"
      loading="lazy"
      width="20"
      height="20"
    />
    sheepyweb3
  </a>
</div>

<style>
  .social-grid {
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .social-pill {
    border: 1px solid transparent;
    border-radius: 7px;
    background: rgba(255, 248, 237, 0.7);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    font-family: var(--font-heading);
    padding: 0.35rem 0.78rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition:
      transform 220ms var(--ease-out-expo),
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .social-pill:hover,
  .social-pill:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(126, 104, 79, 0.38);
    color: var(--text-primary);
    background: var(--bg-surface-hover);
  }

  .social-img {
    width: 20px;
    flex-shrink: 0;
    height: 20px;
    object-fit: contain;
  }
</style>
