---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <p>© {year} Alexzander Stone</p>

    <nav aria-label="Footer links">
      <a href="mailto:alexwrstone@gmail.com" target="_blank" rel="noreferrer">Email</a>
      <a href="https://github.com/alexzander-stone" target="_blank" rel="noreferrer">GitHub</a>
      <a href="https://t.me/SheepyWeb3" target="_blank" rel="noreferrer">Telegram</a>
      <a href="https://x.com/sheepyweb3" target="_blank" rel="noreferrer">X</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    margin-top: 3.2rem;
    padding: 1.2rem 0 0;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.82rem;
  }

  .footer-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  p {
    margin: 0;
    color: var(--text-muted);
    font-size: inherit;
  }

  nav {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  nav a {
    color: var(--text-muted);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--accent-primary);
  }
</style>
