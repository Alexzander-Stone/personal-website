---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bear | Alexzander Stone" description="You found the bear.">
  <Header />

  <main class="bear-page">
    <section class="bear-card glass-panel">
      <p class="eyebrow">Hidden Page</p>
      <h1>You found the bear.</h1>
      <pre aria-label="ASCII bear art">
ʕ•ᴥ•ʔ
      </pre>
      <p class="note">Thanks for exploring.</p>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  .bear-page {
    min-height: calc(100vh - 8rem);
    display: grid;
    align-content: center;
    gap: 2rem;
  }

  .bear-card {
    padding: 1.25rem;
    display: grid;
    gap: 0.8rem;
    max-width: 620px;
  }

  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.82rem;
  }

  h1 {
    margin: 0;
  }

  pre {
    margin: 0;
    width: fit-content;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    padding: 1rem 1.2rem;
    color: var(--text-primary);
  }

  .note {
    margin: 0;
    color: var(--text-secondary);
  }
</style>
