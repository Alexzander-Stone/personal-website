---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Social from '../components/Social.astro';
import { profile } from '../data/profile';

const allProjects = await getCollection('projects');
let highlightedProjects = allProjects.filter((project) => project.data.highlighted);
const experience = [
  {
    company: 'Aptos Labs',
    title: 'Dev Rel → Full-Stack SWE (Move)',
    dates: 'Mar 2024 - Present',
  },
  {
    company: 'MEV Searching (EVM)',
    title: 'Web3 Developer',
    dates: 'Nov 2021 - Mar 2024',
  },
  {
    company: 'Swampfox Technologies',
    title: 'Software Developer',
    dates: 'May 2019 - Nov 2021',
  },
];

highlightedProjects = highlightedProjects.sort((a, b) => {
  return b.data.pubDate.getTime() - a.data.pubDate.getTime();
});
---

<Layout
  title={`${profile.name} | Software Engineer`}
  description={profile.description}
  tags={['alexzander stone', 'software engineer', 'game theory', 'defi', 'portfolio']}
>
  <Header />

  <main>
    <section class="profile" aria-label="Profile summary">
      <img
        class="profile-photo"
        src="/a_s.jpg"
        alt="Portrait of Alexzander Stone"
        width="128"
        height="128"
        loading="eager"
        decoding="async"
      />

      <div class="profile-content">
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="summary">
          {profile.summary}
        </p>

        <ul class="facts" role="list">
          {
            profile.facts.map((fact) => (
              <li>
                <span class="fact-label">{fact.label}</span>
                <span class="fact-value">{fact.value}</span>
              </li>
            ))
          }
        </ul>

        <Social />
      </div>
    </section>

    <section id="experience" class="experience-section" aria-label="Work experience">
      <div class="section-head">
        <h2 class="section-title">Experience</h2>
      </div>

      <ul role="list" class="experience-list">
        {
          experience.map((item) => (
            <li class="experience-item">
              <div class="experience-main">
                <p class="experience-company">{item.company}</p>
                <p class="experience-title">{item.title}</p>
              </div>
              <p class="experience-dates">{item.dates}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="selected-work" class="work-section">
      <div class="section-head">
        <h2 class="section-title">Selected Work</h2>
        <a href="/projects">View all projects</a>
      </div>

      <ul role="list" class="project-grid">
        {
          highlightedProjects.map((project) => (
            <ProjectCard
              title={project.data.shortTitle}
              body={project.data.description}
              photoUrl={project.data.image.url}
              photoAlt={project.data.image.alt}
              href={`/projects/${project.slug}`}
              width={project.data.image.width.mini}
              height={project.data.image.height.mini}
              tags={project.data.tags}
              pubDate={project.data.pubDate}
            />
          ))
        }
      </ul>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  .profile {
    --photo-size: 5.75rem;
    display: grid;
    gap: 0.95rem;
    margin-bottom: var(--section-gap);
  }

  .profile-content {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
  }

  .profile h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.65rem);
  }

  .profile-photo {
    width: var(--photo-size);
    height: var(--photo-size);
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    flex-shrink: 0;
    background: var(--bg-elevated);
  }

  .role {
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .summary {
    margin: 0;
    max-width: 68ch;
    color: var(--text-secondary);
  }

  .facts {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    max-width: 68ch;
  }

  .facts li {
    margin: 0;
    display: flex;
    gap: 0.45rem;
    align-items: baseline;
  }

  .fact-label {
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }

  .fact-label::after {
    content: ':';
  }

  .fact-value {
    color: var(--text-secondary);
    font-size: 0.96rem;
  }

  .work-section {
    display: grid;
    gap: 1rem;
    margin-bottom: var(--section-gap);
  }

  .experience-section {
    display: grid;
    gap: 0.75rem;
    margin-bottom: var(--section-gap);
  }

  .experience-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
  }

  .experience-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin: 0;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .experience-item:first-child {
    padding-top: 0;
  }

  .experience-item:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .experience-main {
    min-width: 0;
  }

  .experience-company {
    margin: 0;
    color: var(--text-primary);
    font-weight: 600;
  }

  .experience-title {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .experience-dates {
    margin: 0;
    white-space: nowrap;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.92rem;
    text-align: right;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section-head h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .section-head a {
    color: var(--accent-primary);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    text-decoration: underline;
  }

  .project-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
  }

  @media (max-width: 640px) {
    .profile {
      --photo-size: 5.25rem;
    }

    .facts li {
      display: grid;
      gap: 0.05rem;
    }

    .experience-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.18rem;
    }

    .experience-dates {
      text-align: left;
    }
  }
</style>
