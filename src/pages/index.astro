---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Social from '../components/Social.astro';
import { profile } from '../data/profile';

const allProjects = await getCollection('projects');
let highlightedProjects = allProjects.filter((project) => project.data.highlighted);
const experience = [
  {
    company: 'Aptos Labs',
    title: 'Dev Rel → Full-Stack SWE (Move)',
    dates: 'Mar 2024 - Present',
  },
  {
    company: 'MEV Searching (EVM)',
    title: 'Web3 Developer',
    dates: 'Nov 2021 - Mar 2024',
  },
  {
    company: 'Swampfox Technologies',
    title: 'Software Developer',
    dates: 'May 2019 - Nov 2021',
  },
];

highlightedProjects = highlightedProjects.sort((a, b) => {
  return b.data.pubDate.getTime() - a.data.pubDate.getTime();
});
---

<Layout
  title={`${profile.name} | Software Engineer`}
  description={profile.description}
  tags={['alexzander stone', 'software engineer', 'game theory', 'defi', 'portfolio']}
>
  <Header />

  <main>
    <section class="profile" aria-label="Profile summary">
      <div class="profile-media">
        <img
          class="profile-photo"
          src="/a_s.jpg"
          alt="Portrait of Alexzander Stone"
          width="128"
          height="128"
          loading="eager"
          decoding="async"
        />
        <span class="profile-divider" aria-hidden="true"></span>
      </div>

      <div class="profile-content">
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="summary">
          {profile.summary}
        </p>

        <ul class="facts" role="list">
          {profile.facts.map((fact) => <li><strong>{fact.label}:</strong> {fact.value}</li>)}
        </ul>

        <Social />
      </div>
    </section>

    <section id="experience" class="experience-section" aria-label="Work experience">
      <div class="section-head">
        <h2>Experience</h2>
      </div>

      <ul role="list" class="experience-list">
        {
          experience.map((item) => (
            <li class="experience-item">
              <p class="experience-line">
                <span class="experience-company">{item.company}</span>
                <span class="experience-separator" aria-hidden="true">•</span>
                <span class="experience-title">{item.title}</span>
                <span class="experience-separator" aria-hidden="true">•</span>
                <span class="experience-dates">{item.dates}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="selected-work" class="work-section">
      <div class="section-head">
        <h2>Selected Work</h2>
        <a href="/projects">View all projects</a>
      </div>

      <ul role="list" class="project-grid">
        {
          highlightedProjects.map((project) => (
            <ProjectCard
              title={project.data.shortTitle}
              body={project.data.description}
              photoUrl={project.data.image.url}
              photoAlt={project.data.image.alt}
              href={`/projects/${project.slug}`}
              width={project.data.image.width.mini}
              height={project.data.image.height.mini}
              tags={project.data.tags}
            />
          ))
        }
      </ul>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  .profile {
    --photo-size: 7.25rem;
    display: grid;
    grid-template-columns: var(--photo-size) minmax(0, 1fr);
    align-items: stretch;
    column-gap: 1rem;
    margin-bottom: 2.2rem;
  }

  .profile-media {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 100%;
  }

  .profile-divider {
    width: 1px;
    flex: 1;
    margin: 0.7rem 0.16rem 0 auto;
    background: var(--border-subtle);
  }

  .profile-content {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
  }

  .profile h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.2rem);
  }

  .profile-photo {
    width: var(--photo-size);
    height: var(--photo-size);
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--border-subtle);
    flex-shrink: 0;
    background: var(--bg-elevated);
  }

  .role {
    margin: 0;
    color: var(--text-secondary);
    font-family: var(--font-heading);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .summary {
    margin: 0;
    max-width: 70ch;
    color: var(--text-secondary);
  }

  .facts {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
    max-width: 70ch;
  }

  .facts li {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.96rem;
  }

  .facts strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .work-section {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.2rem;
  }

  .experience-section {
    display: grid;
    gap: 0.8rem;
    margin-bottom: 2.2rem;
  }

  .experience-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }

  .experience-item {
    margin: 0;
  }

  .experience-line {
    margin: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 0.45rem;
    row-gap: 0.2rem;
  }

  .experience-company,
  .experience-title,
  .experience-separator,
  .experience-dates {
    margin: 0;
  }

  .experience-company {
    font-weight: 600;
    color: var(--text-primary);
  }

  .experience-title {
    color: var(--text-secondary);
  }

  .experience-separator {
    color: var(--text-secondary);
  }

  .experience-dates {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section-head h2 {
    margin: 0;
    font-size: clamp(1.35rem, 2.5vw, 1.9rem);
  }

  .section-head a {
    color: var(--text-primary);
    font-size: 0.9rem;
    text-decoration: underline;
    text-decoration-color: rgba(47, 132, 136, 0.5);
    border-bottom: 1px solid transparent;
  }

  .section-head a:hover,
  .section-head a:focus-visible {
    border-color: rgba(47, 132, 136, 0.65);
  }

  .project-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 980px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .profile {
      --photo-size: 6.5rem;
      grid-template-columns: 1fr;
      row-gap: 0.8rem;
    }

    .profile-media {
      min-height: 0;
    }

    .profile-divider {
      display: none;
    }

    .experience-line {
      column-gap: 0.35rem;
    }

    .experience-separator {
      display: none;
    }
  }
</style>
