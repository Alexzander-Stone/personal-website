---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  // Keep dynamic project routes from colliding with explicit page routes.
  const dedicatedProjectRoutes = new Set(['draft-ai']);

  return projects
    .filter((project) => !dedicatedProjectRoutes.has(project.slug))
    .map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const pubDate = project.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Layout
  title={`${project.data.title} | Alexzander Stone`}
  description={project.data.description}
  ogImage={project.data.image.url}
  ogType="article"
  publishedDate={project.data.pubDate}
  tags={project.data.tags}
>
  <Header />

  <main class="project-page">
    <article>
      <figure class="hero-media">
        <img
          decoding="async"
          loading="eager"
          src={project.data.image.url}
          alt={project.data.image.alt}
          width={project.data.image.width.normal}
          height={project.data.image.height.normal}
        />
      </figure>

      <div class="article-head">
        <p class="source">Source: {project.data.image.source}</p>
        <h1>{project.data.title}</h1>
        <p class="meta">{pubDate}</p>

        <ul class="tags" role="list" aria-label="Project tags">
          {project.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>

      <div class="prose">
        <Content />
      </div>
    </article>

    <aside class="project-progress" aria-label="Section navigation" hidden>
      <p class="project-progress-title">On this page</p>
      <ol id="project-progress-list" class="project-progress-list" role="list"></ol>
    </aside>

    <Footer />
  </main>
</Layout>

<script is:inline>
  (() => {
    const setupProjectProgress = () => {
      if (typeof window.__projectProgressCleanup === 'function') {
        window.__projectProgressCleanup();
        window.__projectProgressCleanup = null;
      }

    const page = document.querySelector('.project-page');
    const prose = page?.querySelector('.prose');
    const progress = page?.querySelector('.project-progress');
    const list = page?.querySelector('#project-progress-list');

    if (!page || !prose || !progress || !list) {
      return;
    }

    const projectTitleHeading = page.querySelector('.article-head h1');
    const projectTitleText = projectTitleHeading?.textContent?.trim().replace(/\s+/g, ' ') ?? '';
    const sourceHeadingPattern = /^source\s*:/i;
    const headingCandidates = Array.from(prose.querySelectorAll('h1, h2, h3, h4, h5, h6'))
      .map((heading) => {
        const text = heading.textContent?.trim().replace(/\s+/g, ' ') ?? '';
        const level = Number.parseInt(heading.tagName.slice(1), 10);

        if (!text || sourceHeadingPattern.test(text) || Number.isNaN(level)) {
          return null;
        }

        return { heading, text, level };
      })
      .filter(Boolean);

    if (headingCandidates.length === 0 && !projectTitleText) {
      progress.setAttribute('hidden', '');
      return;
    }

    const levels = [...new Set(headingCandidates.map(({ level }) => level))].sort((a, b) => a - b);
    const sectionLevel = levels[0] ?? 1;
    const subsectionLevel = levels.find((level) => level > sectionLevel);
    const contentHeadings = headingCandidates.filter(
      ({ level }) => level === sectionLevel || level === subsectionLevel
    );
    const headings = [];

    if (projectTitleHeading && projectTitleText) {
      headings.push({ heading: projectTitleHeading, text: projectTitleText, level: sectionLevel });
    }

    headings.push(...contentHeadings);

    if (headings.length === 0) {
      progress.setAttribute('hidden', '');
      return;
    }

    const slugify = (value) =>
      value
        .toLowerCase()
        .trim()
        .replace(/[^\w\s-]/g, '')
        .replace(/\s+/g, '-');

    list.innerHTML = '';

    headings.forEach(({ heading, text, level }, index) => {
      if (!heading.id) {
        heading.id = `${slugify(text) || 'section'}-${index + 1}`;
      }

      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.textContent = text;
      link.title = text;
      link.className = level === sectionLevel ? 'is-section' : 'is-subsection';
      link.dataset.target = heading.id;
      item.appendChild(link);
      list.appendChild(item);
    });

    progress.removeAttribute('hidden');

    const links = Array.from(list.querySelectorAll('a'));
    const headingElements = headings.map(({ heading }) => heading);
    const headingById = new Map(headingElements.map((heading) => [heading.id, heading]));
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let clickLock = false;
    let clickLockTimeout = 0;
    let scrollRafId = 0;

    const setActive = (id) => {
      links.forEach((link) => {
        const isActive = link.dataset.target === id;
        link.classList.toggle('is-active', isActive);
      });
    };

    const triggerHeadingFlash = (heading) => {
      if (prefersReducedMotion.matches) {
        return;
      }

      heading.classList.remove('heading-flash');
      void heading.offsetWidth;
      heading.classList.add('heading-flash');
      heading.addEventListener(
        'animationend',
        () => {
          heading.classList.remove('heading-flash');
        },
        { once: true }
      );
    };

    const getActiveHeadingId = () => {
      const thresholdY = window.innerHeight * 0.4;
      let activeId = null;

      headingElements.forEach((heading) => {
        if (heading.getBoundingClientRect().top <= thresholdY) {
          activeId = heading.id;
        }
      });

      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 8) {
        return headingElements[headingElements.length - 1]?.id ?? activeId;
      }

      return activeId ?? headingElements[0]?.id;
    };

    const updateActiveFromScroll = () => {
      scrollRafId = 0;

      if (clickLock) {
        return;
      }

      const nextId = getActiveHeadingId();
      if (nextId) {
        setActive(nextId);
      }
    };

    const scheduleActiveUpdate = () => {
      if (scrollRafId) {
        return;
      }

      scrollRafId = window.requestAnimationFrame(updateActiveFromScroll);
    };

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const targetId = link.dataset.target;
        const targetHeading = targetId ? headingById.get(targetId) : null;

        if (!targetId || !targetHeading) {
          return;
        }

        event.preventDefault();
        setActive(targetId);

        if (!prefersReducedMotion.matches) {
          clickLock = true;
          window.clearTimeout(clickLockTimeout);
          clickLockTimeout = window.setTimeout(() => {
            clickLock = false;
            scheduleActiveUpdate();
          }, 1000);
        }

        targetHeading.scrollIntoView({
          behavior: prefersReducedMotion.matches ? 'auto' : 'smooth',
          block: 'start',
        });
        history.replaceState(null, '', `#${targetId}`);
        triggerHeadingFlash(targetHeading);
      });
    });

    window.addEventListener('scroll', scheduleActiveUpdate, { passive: true });
    window.addEventListener('resize', scheduleActiveUpdate);
    window.__projectProgressCleanup = () => {
      window.removeEventListener('scroll', scheduleActiveUpdate);
      window.removeEventListener('resize', scheduleActiveUpdate);
      window.clearTimeout(clickLockTimeout);
      if (scrollRafId) {
        window.cancelAnimationFrame(scrollRafId);
        scrollRafId = 0;
      }
    };

    const fromHash = window.location.hash.slice(1);
    if (fromHash && headingById.has(fromHash)) {
      setActive(fromHash);
    } else if (headings[0]) {
      setActive(headings[0].heading.id);
    }

    scheduleActiveUpdate();
    };

    if (!window.__projectProgressPageLoadBound) {
      window.__projectProgressPageLoadBound = true;
      document.addEventListener('astro:page-load', setupProjectProgress);
    }

    setupProjectProgress();
  })();
</script>

<style>
  .project-page {
    width: min(900px, calc(100% - 2rem));
    position: relative;
  }

  .hero-media {
    margin: 0 calc(50% - 50vw) 1.4rem;
    max-height: min(60vh, 680px);
    position: relative;
    overflow: hidden;
  }

  .hero-media::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: clamp(44px, 8vh, 88px);
    background: linear-gradient(to top, var(--bg-deep), transparent);
    pointer-events: none;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    max-height: min(60vh, 680px);
    object-fit: cover;
  }

  .article-head {
    display: grid;
    gap: 0.72rem;
    margin-bottom: 1.35rem;
  }

  .source,
  .meta {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.84rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.1rem);
  }

  .tags {
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem;
  }

  .tags li {
    margin: 0;
    font-size: var(--tag-font-size);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-primary);
    border: 1px solid var(--tag-border);
    border-radius: var(--tag-radius);
    padding: var(--tag-padding);
    background: var(--tag-bg);
  }

  @keyframes heading-flash {
    0% {
      background-color: rgba(47, 132, 136, 0.18);
    }
    100% {
      background-color: transparent;
    }
  }

  :global(.prose h1),
  :global(.prose h2),
  :global(.prose h3),
  :global(.prose h4),
  :global(.prose h5),
  :global(.prose h6) {
    scroll-margin-top: 6rem;
  }

  :global(.prose h1.heading-flash),
  :global(.prose h2.heading-flash),
  :global(.prose h3.heading-flash),
  :global(.prose h4.heading-flash),
  :global(.prose h5.heading-flash),
  :global(.prose h6.heading-flash) {
    border-radius: 4px;
    animation: heading-flash 900ms var(--ease-out-expo) forwards;
  }

  .project-progress {
    position: fixed;
    top: 7.2rem;
    left: calc(50% + 470px);
    width: 220px;
    background: rgba(255, 248, 237, 0.86);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    box-shadow: var(--shadow-soft);
    padding: 0.72rem 0.72rem 0.76rem;
    z-index: 2;
    backdrop-filter: blur(2px);
  }

  .project-progress-title {
    margin: 0 0 0.45rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-progress-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.18rem;
    position: relative;
  }

  .project-progress-list::before {
    content: '';
    position: absolute;
    left: 0.72rem;
    top: 0.45rem;
    bottom: 0.45rem;
    width: 1px;
    background: rgba(126, 104, 79, 0.36);
  }

  :global(.project-progress-list li) {
    margin: 0;
    position: relative;
  }

  :global(.project-progress-list a) {
    position: relative;
    display: block;
    color: var(--text-secondary);
    font-size: 0.74rem;
    line-height: 1.28;
    text-decoration: none;
    padding: 0.24rem 0.22rem 0.24rem 1.45rem;
    border-radius: 6px;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  :global(.project-progress-list a::before) {
    content: '';
    position: absolute;
    left: 0.56rem;
    top: 0.62rem;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 999px;
    background: var(--bg-deep);
    border: 1px solid rgba(126, 104, 79, 0.5);
  }

  :global(.project-progress-list a.is-subsection) {
    padding-left: 2rem;
    font-size: 0.71rem;
    color: var(--text-muted);
  }

  :global(.project-progress-list a.is-subsection::before) {
    left: 1.2rem;
    top: 0.65rem;
    width: 0.26rem;
    height: 0.26rem;
  }

  :global(.project-progress-list a.is-subsection::after) {
    content: '';
    position: absolute;
    left: 0.72rem;
    top: 0.77rem;
    width: 0.53rem;
    height: 1px;
    background: rgba(126, 104, 79, 0.42);
  }

  :global(.project-progress-list a:hover) {
    background: var(--bg-surface-hover);
  }

  :global(.project-progress-list a.is-active) {
    color: var(--text-primary);
    background: rgba(47, 132, 136, 0.13);
  }

  :global(.project-progress-list a.is-active::before) {
    background: var(--accent-secondary);
    border-color: var(--accent-secondary);
  }

  @media (max-width: 760px) {
    .project-page {
      width: min(900px, calc(100% - 1.4rem));
    }

    :global(.prose h1),
    :global(.prose h2),
    :global(.prose h3),
    :global(.prose h4),
    :global(.prose h5),
    :global(.prose h6) {
      scroll-margin-top: 5.3rem;
    }

    .hero-media {
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 1320px) {
    .project-progress {
      display: none;
    }
  }
</style>
