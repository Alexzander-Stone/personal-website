---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  // Keep dynamic project routes from colliding with explicit page routes.
  const dedicatedProjectRoutes = new Set(['draft-ai']);

  return projects
    .filter((project) => !dedicatedProjectRoutes.has(project.slug))
    .map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const pubDate = project.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Layout
  title={`${project.data.title} | Alexzander Stone`}
  description={project.data.description}
  ogImage={project.data.image.url}
  ogType="article"
  publishedDate={project.data.pubDate}
  tags={project.data.tags}
>
  <Header />

  <main class="project-page">
    <article>
      <figure class="hero-media">
        <img
          decoding="async"
          loading="eager"
          src={project.data.image.url}
          alt={project.data.image.alt}
          width={project.data.image.width.normal}
          height={project.data.image.height.normal}
        />
      </figure>

      <div class="article-head">
        <p class="source">Source: {project.data.image.source}</p>
        <h1>{project.data.title}</h1>
        <p class="meta">{pubDate}</p>

        <ul class="tags" role="list" aria-label="Project tags">
          {project.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>

      <div class="prose">
        <Content />
      </div>
    </article>

    <Footer />
  </main>
</Layout>

<style>
  .project-page {
    width: min(900px, calc(100% - 2rem));
  }

  .hero-media {
    margin: 0 calc(50% - 50vw) 1.4rem;
    max-height: min(60vh, 680px);
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    max-height: min(60vh, 680px);
    object-fit: cover;
  }

  .article-head {
    display: grid;
    gap: 0.55rem;
    margin-bottom: 1rem;
  }

  .source,
  .meta {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.84rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.1rem);
  }

  .tags {
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem;
  }

  .tags li {
    margin: 0;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-primary);
    border: 1px solid rgba(47, 132, 136, 0.44);
    border-radius: 6px;
    padding: 0.22rem 0.62rem;
    background: rgba(47, 132, 136, 0.14);
  }

  @media (max-width: 760px) {
    .project-page {
      width: min(900px, calc(100% - 1.4rem));
    }

    .hero-media {
      margin-bottom: 1rem;
    }
  }
</style>
